{
  "name": "d0kn-wholesale-distribution-web",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --base=./ && npx cap sync android",
    "apk:release": "npm run build:android && cd android && gradlew.bat assembleRelease",
    "assets:android": "node generate-assets.mjs && npx capacitor-assets generate --android",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capgo/capacitor-speech-recognition": "^8.6.0",
    "@capgo/capacitor-speech-synthesis": "^8.0.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
